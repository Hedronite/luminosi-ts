---
import type { Polyhedron } from "@hedronite/lts-primitives";
import { wireframe } from "../lib/wireframe";

interface Props {
  shape: Polyhedron;
  size: number;
}

const { shape, size } = Astro.props;
const segments = wireframe(shape);
---

<svg width={size} height={size} viewBox="-1.2 -1.2 2.4 2.4" aria-hidden="true" fill="none" stroke="currentColor" stroke-linecap="round">
  {segments.map((s) => <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} stroke-width={s.front ? 0.045 : 0.025} stroke-opacity={s.front ? 1 : 0.3} />)}
</svg>
