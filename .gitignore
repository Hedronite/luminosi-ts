# Dependencies and build output
node_modules/
dist/
.turbo/
*.tsbuildinfo
coverage/

# Secrets
.env
.env.*
!.env.example

# Nix and direnv
result
result-*
.direnv/

# Editors and OS
.DS_Store
*.swp

# The last size measurement (tools/assets/src/sizes.ts, run by `bun run validate`)
tools/assets/sizes.json

# Generated by astro (types and content cache)
apps/site/.astro/

# Playwright
playwright-report/
test-results/

# Forge workspaces for image-to-object (lumin new-object): scratch, and they may hold private reference photos
.img-to-object/

# Adoption workspaces (lumin adopt): upstream files copied for porting, scratch
.adopt/

# The planted modules the strict scene spec draws (bun run scenes:plants), made on each run
e2e/scenes/plants/

# The raw upstream files of the vendored folders, fetched by their pins (bun run vendor:fetch): a cache, never committed
.vendor/
