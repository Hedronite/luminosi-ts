{
  "name": "@hedronite/lts-postfx",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  },
  "dependencies": {
    "@hedronite/lts-tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hedronite/lts-core": "workspace:*",
    "@types/three": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  }
}
