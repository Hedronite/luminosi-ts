{
  "name": "@hedronite/lts-icons",
  "version": "0.0.0",
  "license": "(MIT OR Apache-2.0) AND MIT AND ISC AND CC-BY-4.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "import": "./dist/manifest.js"
    },
    "./descriptors": {
      "types": "./dist/descriptors.d.ts",
      "import": "./dist/descriptors.js"
    },
    "./packs": {
      "types": "./dist/packs/index.d.ts",
      "import": "./dist/packs/index.js"
    },
    "./packs/*": {
      "types": "./dist/packs/*.d.ts",
      "import": "./dist/packs/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/licenses && cp licenses/* dist/licenses/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@hedronite/lts-core": "workspace:*",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  }
}
