{
  "name": "@hedronite/lts-scene",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "import": "./dist/emit/index.js"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hedronite/lts-core": "workspace:*",
    "@hedronite/lts-materials": "workspace:*",
    "@hedronite/lts-objects": "workspace:*",
    "@hedronite/lts-postfx": "workspace:*",
    "@hedronite/lts-primitives": "workspace:*",
    "@hedronite/lts-registry": "workspace:*",
    "@hedronite/lts-shaders": "workspace:*",
    "@hedronite/lts-tokens": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/three": "catalog:",
    "fast-check": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
