{
  "name": "@hedronite/lts-scene",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./emit": {
      "types": "./dist/emit/index.d.ts",
      "import": "./dist/emit/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hedronite/lts-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
