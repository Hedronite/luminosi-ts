{
  "name": "@hedronite/lts-adapters",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webgpu": {
      "types": "./dist/webgpu.d.ts",
      "import": "./dist/webgpu.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": "^0.187.0",
    "react": "^19.0.0",
    "@react-three/fiber": "^9.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@react-three/fiber": {
      "optional": true
    }
  },
  "dependencies": {
    "@hedronite/lts-materials": "workspace:*",
    "@hedronite/lts-objects": "workspace:*",
    "@hedronite/lts-postfx": "workspace:*",
    "@hedronite/lts-primitives": "workspace:*",
    "@hedronite/lts-shaders": "workspace:*",
    "@hedronite/lts-tokens": "workspace:*"
  },
  "devDependencies": {
    "@react-three/fiber": "catalog:",
    "@react-three/test-renderer": "catalog:",
    "@types/react": "catalog:",
    "@types/three": "catalog:",
    "react": "catalog:",
    "three": "catalog:",
    "vitest": "catalog:"
  }
}
