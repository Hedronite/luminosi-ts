{
  "name": "@hedronite/lts-tokens",
  "version": "0.0.0",
  "license": "MIT OR Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./theme.css": { "style": "./dist/theme.css", "default": "./dist/theme.css" }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/emit-css.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "fast-check": "catalog:",
    "vitest": "catalog:"
  }
}
