# Static hosting for the catalog (:8080) and the site (:8081). TLS and the public name are the
# front proxy's job (hedronite.com or GitHub Pages later); this serves plain HTTP inside the tailnet.
{
	admin off
	auto_https off
}

(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
	@hashed path /assets/* /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	encode zstd gzip
}

:8080 {
	root * /srv/catalog
	import headers
	# Everything is same-origin. wasm-unsafe-eval: the meshopt decoder and three's WebGPU fallback
	# compile WebAssembly; blob: covers workers three may start.
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' data: blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
	try_files {path} /index.html
	file_server
}

:8081 {
	root * /srv/site
	import headers
	# The page carries its own <meta> CSP with hashes for Astro's inline scripts (astro.config.mjs).
	# A header policy would be enforced as well and block them, so the header adds only what a
	# <meta> policy cannot express.
	header Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
	file_server
}
