{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.spec.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/react/index.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/catalog": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    }
  }
}
