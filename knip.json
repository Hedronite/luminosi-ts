{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.spec.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/react/index.ts",
        "src/manifest.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/scene": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@hedronite/lts-adapters",
        "@hedronite/lts-materials",
        "@hedronite/lts-objects",
        "@hedronite/lts-postfx",
        "@hedronite/lts-primitives",
        "@hedronite/lts-shaders",
        "@hedronite/lts-tokens",
        "@react-three/fiber",
        "@types/react",
        "@types/three",
        "react",
        "three"
      ]
    },
    "apps/catalog": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "tools/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/lumin": {
      "entry": [
        "src/cli.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    }
  },
  "ignoreBinaries": [
    "nu"
  ],
  "ignore": [
    "assets/vendor/**"
  ]
}
