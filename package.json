{
  "name": "luminosi-ts",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*",
      "tools/*"
    ],
    "catalog": {
      "@gltf-transform/core": "4.5.1",
      "@gltf-transform/extensions": "4.5.1",
      "@gltf-transform/functions": "4.5.1",
      "@react-three/fiber": "9.8.2",
      "@react-three/test-renderer": "9.1.1",
      "@tailwindcss/vite": "4.3.5",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "@types/three": "0.187.0",
      "@vitejs/plugin-react": "6.3.0",
      "fast-check": "4.10.2",
      "meshoptimizer": "1.3.0",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "svgo": "4.1.0",
      "tailwindcss": "4.3.5",
      "three": "0.187.0",
      "vite": "8.3.8",
      "vitest": "5.1.0",
      "zod": "4.6.7"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=catalog",
    "lint": "eslint .",
    "boundaries": "depcruise packages apps --config .dependency-cruiser.cjs",
    "knip": "knip",
    "e2e": "playwright test",
    "check": "bun run icons:check && bun run typecheck && bun run build && bun run validate && bun run test && bun run lint && bun run boundaries && bun run knip && bun run e2e",
    "icons": "bun run --filter tool-icons generate",
    "icons:check": "bun run --filter tool-icons check",
    "validate": "bun run --filter tool-assets validate"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@vitest/eslint-plugin": "1.6.28",
    "dependency-cruiser": "18.7.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "knip": "6.45.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
