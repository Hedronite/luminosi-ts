{
  "name": "luminosi-ts",
  "private": true,
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "zod": "4.6.7",
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "vite": "8.3.8",
      "@vitejs/plugin-react": "6.3.0",
      "tailwindcss": "4.3.5",
      "@tailwindcss/vite": "4.3.5",
      "vitest": "5.1.0"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev --filter=catalog"
  },
  "devDependencies": {
    "turbo": "2.11.11",
    "typescript": "6.0.3"
  }
}
